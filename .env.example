# Historical Documentation Analyzer — Environment Configuration
# Copy this file to .env and fill in your API key.

# Option 1: Anthropic API (recommended — supports vision for aerial/topo analysis)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 2: OpenAI API (GPT-4o vision)
# OPENAI_API_KEY=sk-your-key-here

# Option 3: OpenClaw Gateway (if running locally)
# OPENCLAW_URL=http://127.0.0.1:18789/v1/chat/completions
# OPENCLAW_TOKEN=your-token-here
# OPENCLAW_MODEL=anthropic/claude-sonnet-4-6
